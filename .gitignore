# Secrets - never commit API keys
.env
*.key

# Personal financial data produced by the agent (incl. .bak backups and .tmp files)
data/*
!data/.gitkeep

# Receipt / payslip images (may contain personal details)
inbox/*
!inbox/.gitkeep

# Python
__pycache__/
.pytest_cache/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Old sample images taken out of inbox/ (same reason)
old_samples/
candidates/

# Eval images (personal documents) - only the expected answers and the script are in git
evals/images/

# Working notes (plan, decisions, findings) - kept locally, the README has what graders need
docs/PLAN.md
